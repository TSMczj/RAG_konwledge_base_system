# ==============================================================
# 非敏感配置模板
#
# 使用方法：
#   1. 复制本文件为 .env       cp .env.example .env
#   2. 按需修改下面的值
#
# ⚠️ 注意：API Key 不在这个文件里！
#    DEEPSEEK_API_KEY 和 DASHSCOPE_API_KEY 由「操作系统环境变量」提供，
#    代码通过 os.getenv() 读取，绝不写入任何文件，也绝不进版本库。
# ==============================================================

# ---------- 模型 API 端点 ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云百炼嵌入接口端点（二选一，只留一行生效）
# ① 北京地域 —— 本项目已实测可用：
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ② 新加坡 / 国际站地域 —— 把 {WorkspaceId} 换成你的业务空间 ID 后启用：
# DASHSCOPE_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# 提示：不确定用哪个？直接跑 scripts/check_models.py，它会自动探测可用端点并告诉你该填什么。

# ---------- 模型与检索参数 ----------
# 生成模型（deepseek-chat / deepseek-reasoner 已于 2026-07-24 弃用，勿用）
LLM_MODEL=deepseek-v4-flash
# 嵌入模型
EMBEDDING_MODEL=text-embedding-v4
# 向量维度（⚠️ 改动后必须整库重建，否则新旧向量不可比较）
EMBEDDING_DIM=1024
# 单次批量上限（百炼 API 硬限制为 10）
EMBEDDING_BATCH_SIZE=10
# 检索返回条数
TOP_K=5
# 拼进提示词的上下文字数上限（token 粗估）
MAX_CONTEXT_TOKENS=6000
# 生成温度（越低越稳，RAG 建议 0.0 ~ 0.3）
TEMPERATURE=0.2
# 多轮对话保留的轮数
MAX_HISTORY_TURNS=5

# ---------- 分块参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- 存储路径 ----------
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
COLLECTION_NAME=knowledge_base
